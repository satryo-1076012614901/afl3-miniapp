# =====================================================================
# Template konfigurasi development lokal (file ini di-commit).
# Salin menjadi .env di root project:   Copy-Item .env.example .env
# File .env hasil salinan TIDAK di-commit (tercantum di .gitignore).
# Dibaca oleh:
#   - docker compose (compose.local.yml) untuk interpolasi variabel
#   - Spring Boot saat dijalankan dari IDE/Gradle (spring.config.import)
# Tulis nilai tanpa tanda kutip.
# =====================================================================

# --- PostgreSQL lokal (compose.local.yml) ---
POSTGRES_DB=miniapp_db
POSTGRES_USER=miniapp
POSTGRES_PASSWORD=miniapp_local
POSTGRES_PORT=5432

# --- Port aplikasi di host saat dijalankan via compose ---
APP_PORT=8080

# --- Koneksi aplikasi saat dijalankan dari IDE/Gradle (ke PostgreSQL lokal) ---
# Jika POSTGRES_PORT/POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD diubah, sesuaikan juga nilai di bawah.
DB_URL=jdbc:postgresql://localhost:5432/miniapp_db
DB_USERNAME=miniapp
DB_PASSWORD=miniapp_local
DB_POOL_SIZE=10
